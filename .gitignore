# Secrets — jamais publier
.env
.env.*
*.key
*.pem
*.crt
id_rsa
id_ed25519

# Données privées AIgg (identité, mémoire, journal, courriers, sauvegardes, labo)
AIgg/core/
AIgg/memory/
AIgg/journal/
AIgg/inbox/
AIgg/outbox/
AIgg/backups/
