# Secrets — jamais publier
.env
.env.*
*.key
*.pem
*.crt
id_rsa
id_ed25519

# Messages personnels du tuteur (journaux de session, relevés…)
InformationsProjetAIgg/Message*.txt

# Dossier privé entre le tuteur et AIgg — jamais publié sur le dépôt
InformationsProjetAIgg/

# Artéfacts Canal (cadrage/documents de conception du tuteur — canal d'information)
Canal_*
InformationsProjetAIgg/Canal_*

# Données privées AIgg (identité, mémoire, journal, courriers, sauvegardes, labo)
AIgg/core/
AIgg/memory/
AIgg/journal/
AIgg/inbox/
AIgg/outbox/
AIgg/backups/
AIgg/notebook/
AIgg/senses/
AIgg/tools/*/providers.json

# Artefact généré localement (représentation)
AIgg/web/public/avatar.svg

# Bibliothèques de spécialisation : privées par défaut (hors dépôt)
AIgg/libraries/*
!AIgg/libraries/examples/
!AIgg/libraries/examples/**
AIgg/libraries/_trash/

# Fichiers temporaires
*.tmp
*.log
Thumbs.db
.DS_Store